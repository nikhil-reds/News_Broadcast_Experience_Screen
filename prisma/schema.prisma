// Prisma Schema for Multi-Camera Interactive Video & News Broadcast Experience System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Stores uploaded or recorded studio master audio files (stored in MinIO `audio` bucket)
model AudioFile {
  id          String       @id @default(uuid())
  filename    String       @unique
  url         String
  bucket      String       @default("audio")
  objectKey   String?
  contentType String?
  size        Int
  duration    Float?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  transcripts Transcript[]

  @@map("audio_files")
}

/// Stores camera/studio video recordings (stored in MinIO `videos` bucket)
model VideoRecording {
  id          String   @id @default(uuid())
  filename    String   @unique
  url         String
  bucket      String   @default("videos")
  objectKey   String
  contentType String?
  size        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("video_recordings")
}

/// Stores full speech-to-text transcript output generated by Whisper (Docker / Cloud / CLI)
model Transcript {
  id          String              @id @default(uuid())
  sourceAudio String
  audioFile   AudioFile?          @relation(fields: [audioFileId], references: [id], onDelete: Cascade)
  audioFileId String?
  language    String              @default("en")
  duration    Float
  sttEngine   String              @default("Docker Faster-Whisper")
  text        String              @db.Text
  srtContent  String?             @db.Text
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  segments    TranscriptSegment[]

  @@map("transcripts")
}

/// Stores individual timestamped speech sentences/segments for live teleprompter audio sync
model TranscriptSegment {
  id           String     @id @default(uuid())
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  transcriptId String
  segmentIndex Int
  start        Float
  end          Float
  text         String     @db.Text
  speaker      String?
  createdAt    DateTime   @default(now())

  @@index([transcriptId])
  @@map("transcript_segments")
}

/// Stores studio interactive screen state across the 12 screens
model BroadcastScreen {
  id           String   @id @default(uuid())
  screenNumber Int      @unique
  name         String
  activeView   String   @default("teleprompter")
  isActive     Boolean  @default(true)
  settings     String?  @db.Text
  updatedAt    DateTime @updatedAt

  @@map("broadcast_screens")
}

/// Stores camera feed recordings and stream settings
model CameraFeed {
  id           String   @id @default(uuid())
  cameraNumber Int      @unique
  name         String
  streamUrl    String?
  status       String   @default("offline")
  createdAt    DateTime @default(now())

  @@map("camera_feeds")
}
