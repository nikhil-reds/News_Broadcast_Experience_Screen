// Prisma Schema for Multi-Camera Interactive Video & News Broadcast Experience System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Stores uploaded or recorded studio master audio files (stored in MinIO `audio` bucket)
model AudioFile {
  id          String       @id @default(uuid())
  filename    String       @unique
  url         String
  bucket      String       @default("audio")
  objectKey   String?
  contentType String?
  size        Int
  duration    Float?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  transcripts Transcript[]

  @@map("audio_files")
}

/// Stores camera/studio video recordings (stored in MinIO `videos` bucket)
model VideoRecording {
  id          String   @id @default(uuid())
  filename    String   @unique
  url         String
  bucket      String   @default("videos")
  objectKey   String
  contentType String?
  size        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("video_recordings")
}

/// Stores full speech-to-text transcript output generated by Whisper (Docker / Cloud / CLI)
model Transcript {
  id          String              @id @default(uuid())
  sourceAudio String
  audioFile   AudioFile?          @relation(fields: [audioFileId], references: [id], onDelete: Cascade)
  audioFileId String?
  language    String              @default("en")
  duration    Float
  sttEngine   String              @default("Docker Faster-Whisper")
  text        String              @db.Text
  srtContent  String?             @db.Text
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  segments     TranscriptSegment[]
  translations TranscriptTranslation[]

  @@map("transcripts")
}

/// Stores per-language translations of a transcript's English text (Qwen), stored as .txt in MinIO `transcripts` bucket
model TranscriptTranslation {
  id           String     @id @default(uuid())
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  transcriptId String
  language     String     // "German" | "Hindi" | "French" | "Spanish"
  langCode     String     // "de" | "hi" | "fr" | "es"
  text         String     @db.Text
  bucket       String     @default("transcripts")
  objectKey    String
  url          String
  model        String     @default("qwen2.5:3b")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  segments TranscriptTranslationSegment[]
  audio    TranslationAudio?

  @@unique([transcriptId, language])
  @@map("transcript_translations")
}

/// Stores CosyVoice2-synthesized speech for a translation, stored as .wav in MinIO `tts-audio` bucket
model TranslationAudio {
  id            String                @id @default(uuid())
  translation   TranscriptTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  translationId String                @unique
  language      String
  langCode      String
  bucket        String                @default("tts-audio")
  objectKey     String
  url           String
  size          Int
  engine        String                @default("CosyVoice2-0.5B")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@map("translation_audio")
}

/// Stores individual timestamped translated sentences/segments per language, mirrors TranscriptSegment
model TranscriptTranslationSegment {
  id            String                @id @default(uuid())
  translation   TranscriptTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  translationId String
  segmentIndex  Int
  start         Float
  end           Float
  text          String                @db.Text
  createdAt     DateTime              @default(now())

  @@index([translationId])
  @@map("transcript_translation_segments")
}

/// Stores individual timestamped speech sentences/segments for live teleprompter audio sync
model TranscriptSegment {
  id           String     @id @default(uuid())
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  transcriptId String
  segmentIndex Int
  start        Float
  end          Float
  text         String     @db.Text
  speaker      String?
  createdAt    DateTime   @default(now())

  @@index([transcriptId])
  @@map("transcript_segments")
}

/// Stores studio interactive screen state across the 12 screens
model BroadcastScreen {
  id           String   @id @default(uuid())
  screenNumber Int      @unique
  name         String
  activeView   String   @default("teleprompter")
  isActive     Boolean  @default(true)
  settings     String?  @db.Text
  updatedAt    DateTime @updatedAt

  @@map("broadcast_screens")
}

/// Stores camera feed recordings and stream settings
model CameraFeed {
  id           String   @id @default(uuid())
  cameraNumber Int      @unique
  name         String
  streamUrl    String?
  status       String   @default("offline")
  createdAt    DateTime @default(now())

  @@map("camera_feeds")
}

/// Tracks one Screen 11/12 export render (reel + language + aspect -> final video)
model VideoJob {
  id            String   @id @default(uuid())
  reelFilename  String
  sourceAudio   String
  language      String
  aspect        String   // "portrait" | "landscape"
  status        String   @default("queued") // "queued" | "processing" | "completed" | "failed"
  outputFilename String?
  outputUrl     String?
  size          Int?
  errorMessage  String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([reelFilename, language, aspect])
  @@map("video_jobs")
}

/// Sponsored ad campaigns rotated into the Screen 09/10 banner overlays
model AdCampaign {
  id          String   @id @default(uuid())
  sponsor     String
  text        String
  code        String   @unique
  startTime   DateTime @default(now())
  endTime     DateTime
  priority    Int      @default(5)
  isActive    Boolean  @default(true)
  impressions Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ad_campaigns")
}
