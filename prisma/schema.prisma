// Prisma Schema for Multi-Camera Interactive Video & News Broadcast Experience System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Stores uploaded or recorded studio master audio files (stored in MinIO `audio` bucket)
model AudioFile {
  id          String       @id @default(uuid())
  filename    String       @unique
  url         String
  bucket      String       @default("audio")
  objectKey   String?
  contentType String?
  size        Int
  duration    Float?
  sessionId   String?
  session     BroadcastSession? @relation(fields: [sessionId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  transcripts Transcript[]

  @@index([sessionId])
  @@map("audio_files")
}

/// Stores camera/studio video recordings (stored in MinIO `videos` bucket)
model VideoRecording {
  id          String   @id @default(uuid())
  filename    String   @unique
  url         String
  bucket      String   @default("videos")
  objectKey   String
  contentType String?
  size        Int
  sessionId   String?
  session     BroadcastSession? @relation(fields: [sessionId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sessionId])
  @@map("video_recordings")
}

/// One "Start Recording" -> "End Recording" take: ties the 3 camera uploads and
/// the 1 master-audio upload together so the rest of the pipeline (highlight
/// pairing, screens 1-6 "current footage") doesn't have to guess from filename
/// timestamps. Also carries the operator's Screen 07/08 selections so Screens
/// 11/12 know which background and subtitle language to bake into the export.
model BroadcastSession {
  id                       String    @id @default(uuid())
  /// Human-friendly "Generation #N" number for logs/UI — this row IS the
  /// generation record for one full camera1+camera2+camera3+audio recording
  /// cycle (see docs/generation-pipeline.md).
  seq                      Int       @unique @default(autoincrement())
  status                   String    @default("recording") // "recording" | "processing" | "ready"
  /// Whether every *base* pipeline task for this generation (transcription,
  /// all 4 translations, all 4 TTS, highlight-analysis, highlight-reel, all 5
  /// green-screen backgrounds) has finished — independent of whether any
  /// individual screen has published this generation yet.
  pipelineStatus           String    @default("processing") // "processing" | "ready" | "failed"
  selectedBackgroundId     String?
  selectedSubtitleLanguage String    @default("English")
  startedAt                DateTime  @default(now())
  endedAt                  DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  videoRecordings        VideoRecording[]
  audioFiles             AudioFile[]
  transcripts            Transcript[]
  transcriptTranslations TranscriptTranslation[]
  translationAudios      TranslationAudio[]
  videoJobs              VideoJob[]
  generationTasks        GenerationTask[]
  currentPublications    ScreenPublication[] @relation("CurrentPublications")
  pendingPublications    ScreenPublication[] @relation("PendingPublications")

  @@map("broadcast_sessions")
}

/// Per-generation status of every pipeline task (transcription, one per
/// translation language, one per TTS language, highlight-analysis,
/// highlight-reel, one per green-screen background). The single source of
/// truth for retries, stale-generation checks, and per-screen readiness —
/// see docs/generation-pipeline.md.
model GenerationTask {
  id           String    @id @default(uuid())
  generationId String
  generation   BroadcastSession @relation(fields: [generationId], references: [id], onDelete: Cascade)
  taskType     String    // e.g. "transcription" | "translation-de" | "tts-hi" | "highlight-reel" | "greenscreen-city-skyline" | "video-export-11"
  status       String    @default("pending") // "pending" | "processing" | "completed" | "failed" | "cancelled" (watchdog: stale, no live generation/variant to recover for)
  attempt      Int       @default(0)
  maxAttempts  Int       @default(3)
  jobId        String?
  errorMessage String?   @db.Text
  startedAt    DateTime?
  completedAt  DateTime?
  /// Watchdog fields (app/worker/watchdog.ts) — a worker still alive but
  /// wedged on a promise that never resolves keeps its BullMQ lock renewed,
  /// so lock expiry alone can't detect it; this heartbeat can.
  lastHeartbeatAt DateTime?
  progressPercent Int?
  progressMessage String?
  /// OS pid of a child process *this worker itself* spawned (ffmpeg) — used
  /// only for best-effort orphan cleanup, never trusted for correctness.
  processId       Int?
  /// Optimistic-lock guard so two watchdog instances can't both act on the
  /// same stale row — see the claim step in app/worker/watchdog.ts.
  recoveryAttempt Int       @default(0)
  /// Snapshot of the exact arguments this task's enqueue*() call in
  /// lib/queue.ts was given — the watchdog needs this to actually
  /// reconstruct a re-enqueue when a task's BullMQ job has gone missing
  /// entirely (crash before enqueue landed, Redis data lost); without it
  /// there'd be nothing to call enqueueTranscription/enqueueTranslations/etc.
  /// with.
  payload      Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([generationId, taskType])
  @@index([generationId])
  @@map("generation_tasks")
}

/// What each of the 12 screens actually renders: the last known-good
/// ("current") generation/variant, plus at most one in-flight ("pending")
/// one. A screen only ever swaps `current*` for `pending*` once every
/// required GenerationTask for that screen has completed successfully — see
/// docs/generation-pipeline.md.
model ScreenPublication {
  id                   String    @id @default(uuid())
  screenId             Int       @unique
  currentGenerationId  String?
  currentGeneration    BroadcastSession? @relation("CurrentPublications", fields: [currentGenerationId], references: [id])
  /// Snapshot of the params actually being shown, e.g. {"language":"Hindi","backgroundId":"newsroom-blue","aspect":"landscape"}
  currentParams        Json?
  pendingGenerationId  String?
  pendingGeneration    BroadcastSession? @relation("PendingPublications", fields: [pendingGenerationId], references: [id])
  pendingParams        Json?
  pendingStatus        String    @default("idle") // "idle" | "preparing" | "failed"
  pendingFailureReason String?   @db.Text
  updatedAt            DateTime  @updatedAt

  @@map("screen_publications")
}

/// Stores full speech-to-text transcript output generated by Whisper (Docker / Cloud / CLI)
model Transcript {
  id           String              @id @default(uuid())
  sourceAudio  String
  audioFile    AudioFile?          @relation(fields: [audioFileId], references: [id], onDelete: Cascade)
  audioFileId  String?
  /// Which recording cycle this transcript belongs to — added so the
  /// transcription→translation→TTS chain can be scoped/staled by generation
  /// instead of resolved purely by "newest transcript for this sourceAudio".
  generationId String?
  generation   BroadcastSession?   @relation(fields: [generationId], references: [id])
  language     String              @default("en")
  duration     Float
  sttEngine    String              @default("Docker Faster-Whisper")
  text         String              @db.Text
  srtContent   String?             @db.Text
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  segments     TranscriptSegment[]
  translations TranscriptTranslation[]

  @@index([generationId])
  @@map("transcripts")
}

/// Stores per-language translations of a transcript's English text (Qwen), stored as .txt in MinIO `transcripts` bucket
model TranscriptTranslation {
  id           String     @id @default(uuid())
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  transcriptId String
  /// Same recording cycle as the source Transcript — duplicated here (rather
  /// than joined through) so translation/TTS workers can stale-check without
  /// an extra hop.
  generationId String?
  generation   BroadcastSession? @relation(fields: [generationId], references: [id])
  language     String     // "German" | "Hindi" | "French" | "Spanish"
  langCode     String     // "de" | "hi" | "fr" | "es"
  text         String     @db.Text
  bucket       String     @default("transcripts")
  objectKey    String
  url          String
  model        String     @default("qwen2.5:3b")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  segments TranscriptTranslationSegment[]
  audio    TranslationAudio?

  @@unique([transcriptId, language])
  @@index([generationId])
  @@map("transcript_translations")
}

/// Stores CosyVoice2-synthesized speech for a translation, stored as .wav in MinIO `tts-audio` bucket
model TranslationAudio {
  id            String                @id @default(uuid())
  translation   TranscriptTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  translationId String                @unique
  generationId  String?
  generation    BroadcastSession?     @relation(fields: [generationId], references: [id])
  language      String
  langCode      String
  bucket        String                @default("tts-audio")
  objectKey     String
  url           String
  size          Int
  engine        String                @default("CosyVoice2-0.5B")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([generationId])
  @@map("translation_audio")
}

/// Stores individual timestamped translated sentences/segments per language, mirrors TranscriptSegment
model TranscriptTranslationSegment {
  id            String                @id @default(uuid())
  translation   TranscriptTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  translationId String
  segmentIndex  Int
  start         Float
  end           Float
  text          String                @db.Text
  createdAt     DateTime              @default(now())

  @@index([translationId])
  @@map("transcript_translation_segments")
}

/// Stores individual timestamped speech sentences/segments for live teleprompter audio sync
model TranscriptSegment {
  id           String     @id @default(uuid())
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  transcriptId String
  segmentIndex Int
  start        Float
  end          Float
  text         String     @db.Text
  speaker      String?
  createdAt    DateTime   @default(now())

  @@index([transcriptId])
  @@map("transcript_segments")
}

/// Stores studio interactive screen state across the 12 screens
model BroadcastScreen {
  id           String   @id @default(uuid())
  screenNumber Int      @unique
  name         String
  activeView   String   @default("teleprompter")
  isActive     Boolean  @default(true)
  settings     String?  @db.Text
  updatedAt    DateTime @updatedAt

  @@map("broadcast_screens")
}

/// Stores camera feed recordings and stream settings
model CameraFeed {
  id           String   @id @default(uuid())
  cameraNumber Int      @unique
  name         String
  streamUrl    String?
  status       String   @default("offline")
  createdAt    DateTime @default(now())

  @@map("camera_feeds")
}

/// Tracks one Screen 11/12 export render (reel + language + aspect + background -> final video)
model VideoJob {
  id            String   @id @default(uuid())
  reelFilename  String
  sourceAudio   String
  /// Which recording cycle this export renders from — lets the video-export
  /// worker detect a superseded generation before publishing, and lets
  /// cleanup find every export tied to an old generation.
  generationId  String?
  generation    BroadcastSession? @relation(fields: [generationId], references: [id])
  language      String
  aspect        String   // "portrait" | "landscape"
  /// A lib/green-screen.ts background id, or "none" (NO_BACKGROUND in
  /// lib/video-export.ts) for no background swap. Not nullable: Postgres
  /// treats every NULL as distinct for uniqueness purposes, which would let
  /// two "no background" requests for the same (reel, language, aspect)
  /// bypass the unique constraint below and both re-render from scratch.
  backgroundId  String   @default("none")
  status        String   @default("queued") // "queued" | "processing" | "completed" | "failed"
  outputFilename String?
  outputUrl     String?
  size          Int?
  errorMessage  String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([reelFilename, language, aspect, backgroundId])
  @@index([generationId])
  @@map("video_jobs")
}

/// Sponsored ad campaigns rotated into the Screen 09/10 banner overlays
model AdCampaign {
  id          String   @id @default(uuid())
  sponsor     String
  text        String
  code        String   @unique
  startTime   DateTime @default(now())
  endTime     DateTime
  priority    Int      @default(5)
  isActive    Boolean  @default(true)
  impressions Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ad_campaigns")
}
