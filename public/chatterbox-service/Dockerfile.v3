# The existing tested image supplies RTX 5080-compatible Torch/CUDA.
FROM news_broadcast_experience_screen-chatterbox-gpu:latest
COPY vendor/resemble-ai-chatterbox-5de7a54 /opt/chatterbox-v3
RUN pip install --no-cache-dir transformers==5.2.0 spacy-pkuseg==1.0.1 pyloudnorm==0.2.0 omegaconf==2.3.0 \
    && pip install --no-cache-dir --no-deps /opt/chatterbox-v3 \
    && python -c "from spacy_pkuseg import pkuseg; pkuseg()"
COPY server.py /app/server.py
COPY voices /app/voices
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 CHATTERBOX_DEVICE=cuda
EXPOSE 9601
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "9601"]

